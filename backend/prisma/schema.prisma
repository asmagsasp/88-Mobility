// Prisma Schema para 88 Mobility — SQLite (Banco de dados local em arquivo)
// Zero-config: Não necessita de servidor PostgreSQL externo ou Docker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Model: Usuário (passageiros, motoristas e admins)
// ============================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String   @unique
  name         String
  passwordHash String
  role         String   @default("PASSENGER") // PASSENGER, DRIVER, ADMIN
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  avatar       String?
  rating       Float    @default(5.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relações
  driverProfile    DriverProfile?
  ridesAsPassenger Ride[]          @relation("PassengerRides")
  ridesAsDriver    Ride[]          @relation("DriverRides")
  payments         Payment[]
  ratingsGiven     Rating[]        @relation("RatingsGiven")
  ratingsReceived  Rating[]        @relation("RatingsReceived")
  deviceTokens     DeviceToken[]
  pricingUpdates   PricingConfig[] @relation("PricingUpdatedBy")
  driverPayouts    DriverPayout[]  @relation("DriverPayouts")

  @@map("users")
}

// ============================================================
// Model: Perfil do Motorista
// ============================================================
model DriverProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  licenseNumber     String?   @unique
  licenseExpiry     DateTime?
  vehiclePlate      String?   @unique
  vehicleModel      String?   @default("Honda Fit")
  vehicleYear       Int?      @default(2020)
  vehicleColor      String?   @default("Prata")
  vehicleRenavam    String?

  // Documentos CNH e CRLV (fotos/URLs)
  cnhPhotoUrl       String?
  crlvPhotoUrl      String?

  // Dados Bancários (Repasse 88% via PIX)
  pixKeyType        String?   // CPF, EMAIL, PHONE, RANDOM
  pixKey            String?
  pixBankName       String?
  pixAccountHolder  String?

  isApproved        Boolean   @default(true)
  documentsVerified Boolean   @default(false)
  isOnline          Boolean   @default(false)
  currentLat        Float?
  currentLng        Float?
  totalKm           Float     @default(0)
  totalEarnings     Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relação
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

// ============================================================
// Model: Corrida
// ============================================================
model Ride {
  id                 String    @id @default(uuid())
  passengerId        String
  driverId           String?
  status             String    @default("REQUESTED") // REQUESTED, ACCEPTED, DRIVER_ARRIVING, IN_PROGRESS, COMPLETED, CANCELLED

  // Origem
  originLat          Float
  originLng          Float
  originAddress      String

  // Destino
  destinationLat     Float
  destinationLng     Float
  destinationAddress String

  // Distância e valores
  estimatedKm        Float
  actualKm           Float?

  // Snapshot dos valores no momento da solicitação
  pricePerKm         Float
  platformFee        Float     @default(2.00) // Taxa fixa R$ 2,00

  // Valores financeiros calculados
  totalAmount        Float?
  driverAmount       Float?    // 88% do valor por Km
  platformAmount     Float?    // 12% do valor por Km + taxa fixa

  // Pagamento
  paymentMethod      String    @default("CASH") // CREDIT_CARD, DEBIT_CARD, PIX, CASH, NEXT_RIDE
  paymentStatus      String    @default("PENDING") // PENDING, PAID, FAILED, REFUNDED

  // Timestamps do ciclo de vida
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relações
  passenger    User          @relation("PassengerRides", fields: [passengerId], references: [id])
  driver       User?         @relation("DriverRides", fields: [driverId], references: [id])
  payment      Payment?
  driverPayout DriverPayout?
  ratings      Rating[]

  @@map("rides")
}

// ============================================================
// Model: Configuração de Preço (gerenciado pelo admin)
// ============================================================
model PricingConfig {
  id            String   @id @default(uuid())
  pricePerKm    Float    // Preço por Km (ex: R$ 2.50)
  platformFee   Float    @default(2.00) // Taxa fixa de manutenção (R$ 2.00)
  driverSplit   Float    @default(0.88) // 88% do valor do Km para o motorista
  platformSplit Float    @default(0.12) // 12% do valor do Km para a plataforma
  isActive      Boolean  @default(true)
  updatedBy     String   // ID do admin
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  // Relação
  admin User @relation("PricingUpdatedBy", fields: [updatedBy], references: [id])

  @@map("pricing_configs")
}

// ============================================================
// Model: Pagamento
// ============================================================
model Payment {
  id              String   @id @default(uuid())
  rideId          String   @unique
  userId          String
  amount          Float
  method          String   @default("CASH")
  status          String   @default("PENDING")
  gateway         String?  @default("INFINITEPAY") // INFINITEPAY, STRIPE, MERCADOPAGO, CASH
  gatewayId       String?
  gatewayResponse String?
  checkoutUrl     String?  // Link gerado no Checkout da InfinitePay
  orderNsu        String?  // Identificador único do pedido na 88 Mobility / InfinitePay
  transactionNsu  String?  // Identificador da transação retornado pela adquirente
  captureMethod   String?  // pix, credit_card
  driverShare     Float?   // 88% do valor da corrida
  platformFee     Float?   // 12% do valor da corrida + taxas
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  ride Ride @relation(fields: [rideId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("payments")
}

// ============================================================
// Model: Repasse ao Motorista (88% via PIX automático)
// ============================================================
model DriverPayout {
  id            String    @id @default(uuid())
  rideId        String    @unique
  driverId      String
  amount        Float     // 88% da corrida
  pixKey        String    // Chave PIX cadastrada
  pixKeyType    String    // CPF, EMAIL, PHONE, RANDOM
  pixBankName   String?
  status        String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  provider      String    @default("PIX_AUTOMATIC")
  transactionId String?   // ID da transação Pix de saída / endToEndId
  receiptUrl    String?
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relações
  ride   Ride @relation(fields: [rideId], references: [id])
  driver User @relation("DriverPayouts", fields: [driverId], references: [id])

  @@map("driver_payouts")
}

// ============================================================
// Model: Avaliação
// ============================================================
model Rating {
  id         String   @id @default(uuid())
  rideId     String
  fromUserId String
  toUserId   String
  score      Int      // 1 a 5 estrelas
  comment    String?
  createdAt  DateTime @default(now())

  // Relações
  ride     Ride @relation(fields: [rideId], references: [id])
  fromUser User @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser   User @relation("RatingsReceived", fields: [toUserId], references: [id])

  @@unique([rideId, fromUserId])
  @@map("ratings")
}

// ============================================================
// Model: Token de dispositivo para push notifications
// ============================================================
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   @default("ANDROID") // IOS, ANDROID
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ============================================================
// Model: Eventos de sincronização em tempo real (Rides Live Events)
// ============================================================
model RideSyncEvent {
  id        String   @id @default(uuid())
  rideId    String
  type      String   // REQUEST_RIDE, ACCEPT_RIDE, DRIVER_LOCATION, etc.
  payload   String   // JSON string com dados do evento
  createdAt DateTime @default(now())

  @@index([rideId])
  @@map("ride_sync_events")
}
