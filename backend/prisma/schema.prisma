// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enum: papéis do usuário no sistema
// ============================================================
enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

// ============================================================
// Enum: status possíveis de uma corrida
// ============================================================
enum RideStatus {
  REQUESTED       // Passageiro solicitou
  ACCEPTED        // Motorista aceitou
  DRIVER_ARRIVING // Motorista a caminho
  IN_PROGRESS     // Corrida em andamento
  COMPLETED       // Corrida finalizada
  CANCELLED       // Corrida cancelada
}

// ============================================================
// Enum: métodos de pagamento aceitos
// ============================================================
enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  CASH
  NEXT_RIDE // Cobrança na próxima corrida (débito automático)
}

// ============================================================
// Enum: status do pagamento
// ============================================================
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================================================
// Enum: plataformas de dispositivo para push notifications
// ============================================================
enum DevicePlatform {
  IOS
  ANDROID
}

// ============================================================
// Model: Usuário (passageiros, motoristas e admins)
// ============================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(PASSENGER)
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  avatar       String?
  rating       Float    @default(5.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relações
  driverProfile   DriverProfile?
  ridesAsPassenger Ride[]         @relation("PassengerRides")
  ridesAsDriver   Ride[]         @relation("DriverRides")
  payments        Payment[]
  ratingsGiven    Rating[]       @relation("RatingsGiven")
  ratingsReceived Rating[]       @relation("RatingsReceived")
  deviceTokens    DeviceToken[]
  pricingUpdates  PricingConfig[] @relation("PricingUpdatedBy")

  @@map("users")
}

// ============================================================
// Model: Perfil do Motorista
// ============================================================
model DriverProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  licenseNumber     String   @unique
  licenseExpiry     DateTime
  vehiclePlate      String   @unique
  vehicleModel      String
  vehicleYear       Int
  vehicleColor      String
  isApproved        Boolean  @default(false)
  documentsVerified Boolean  @default(false)
  isOnline          Boolean  @default(false)
  currentLat        Float?
  currentLng        Float?
  totalKm           Float    @default(0)
  totalEarnings     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relação
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

// ============================================================
// Model: Corrida
// ============================================================
model Ride {
  id                 String        @id @default(uuid())
  passengerId        String
  driverId           String?
  status             RideStatus    @default(REQUESTED)

  // Origem
  originLat          Float
  originLng          Float
  originAddress      String

  // Destino
  destinationLat     Float
  destinationLng     Float
  destinationAddress String

  // Distância e valores
  estimatedKm        Float
  actualKm           Float?

  // IMPORTANTE: snapshot dos valores no momento da solicitação
  // Garante que variações futuras não afetem corridas em andamento
  pricePerKm         Float
  platformFee        Float    @default(2.00) // Taxa fixa de manutenção (snapshot)

  // Valores financeiros calculados
  totalAmount        Float?
  driverAmount       Float?        // 88% do valor por Km
  platformAmount     Float?        // 12% do valor por Km + taxa fixa

  // Pagamento
  paymentMethod      PaymentMethod @default(CASH)
  paymentStatus      PaymentStatus @default(PENDING)

  // Timestamps do ciclo de vida
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relações
  passenger User     @relation("PassengerRides", fields: [passengerId], references: [id])
  driver    User?    @relation("DriverRides", fields: [driverId], references: [id])
  payment   Payment?
  ratings   Rating[]

  @@map("rides")
}

// ============================================================
// Model: Configuração de Preço (gerenciado pelo admin)
// ============================================================
model PricingConfig {
  id              String   @id @default(uuid())
  pricePerKm      Float    // Preço por quilômetro em BRL
  platformFee     Float    @default(2.00) // Taxa fixa de manutenção da plataforma (R$)
  driverSplit     Float    @default(0.88) // 88% do valor do Km para o motorista
  platformSplit   Float    @default(0.12) // 12% do valor do Km para a plataforma
  isActive        Boolean  @default(true)
  updatedBy       String   // ID do admin que atualizou
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())

  // Relação
  admin User @relation("PricingUpdatedBy", fields: [updatedBy], references: [id])

  @@map("pricing_configs")
}

// ============================================================
// Model: Pagamento
// ============================================================
model Payment {
  id              String        @id @default(uuid())
  rideId          String        @unique
  userId          String
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  gatewayId       String?       // ID da transação no gateway (Stripe/MercadoPago)
  gatewayResponse Json?         // Resposta completa do gateway
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relações
  ride Ride @relation(fields: [rideId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("payments")
}

// ============================================================
// Model: Avaliação (motorista avalia passageiro e vice-versa)
// ============================================================
model Rating {
  id         String   @id @default(uuid())
  rideId     String
  fromUserId String
  toUserId   String
  score      Int      // 1 a 5 estrelas
  comment    String?
  createdAt  DateTime @default(now())

  // Relações
  ride     Ride @relation(fields: [rideId], references: [id])
  fromUser User @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser   User @relation("RatingsReceived", fields: [toUserId], references: [id])

  // Um usuário só pode avaliar outro uma vez por corrida
  @@unique([rideId, fromUserId])
  @@map("ratings")
}

// ============================================================
// Model: Token de dispositivo para push notifications
// ============================================================
model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  // Relação
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}
