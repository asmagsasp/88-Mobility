# ==============================================
# 88 Mobility Backend — Variáveis de Ambiente
# ==============================================

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/88mobility?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="seu_jwt_secret_super_seguro_aqui"
JWT_REFRESH_SECRET="seu_jwt_refresh_secret_super_seguro_aqui"

# Servidor
PORT=3000
NODE_ENV="development"

# Google Maps
GOOGLE_MAPS_API_KEY="sua_google_maps_api_key_aqui"

# Stripe (pagamentos internacionais)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Mercado Pago (pagamentos Brasil - PIX, cartão)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."

# Admin padrão (será criado no seed)
ADMIN_EMAIL="admin@88mobility.com"
ADMIN_PASSWORD_HASH="$2b$10$..." # bcrypt hash da senha

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:19006"
