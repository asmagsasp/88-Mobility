# ==============================================
# 88 Mobility Backend — Variáveis de Ambiente
# ==============================================

# Banco de dados SQLite local (zero-config, arquivo criado automaticamente)
DATABASE_URL="file:./dev.db"

# Redis (opcional — usa fallback em memória quando ausente)
REDIS_URL=""

# JWT
JWT_SECRET="88mobility_super_secret_jwt_key_2026_dev_min32chars!"
JWT_REFRESH_SECRET="88mobility_super_refresh_jwt_key_2026_dev_min32!"

# Servidor
PORT=3000
NODE_ENV="development"

# Google Maps (opcional — fallback para Haversine e OSRM)
GOOGLE_MAPS_API_KEY=""

# Stripe (opcional em dev)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mercado Pago (opcional em dev)
MERCADO_PAGO_ACCESS_TOKEN=""

# Admin padrão (criado no npm run seed)
ADMIN_EMAIL="admin@88mobility.com"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:19006,*"
