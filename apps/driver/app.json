{
  "expo": {
    "name": "88 Mobility — Motorista",
    "slug": "88mobility-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eightyeightmobility.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Para mostrar sua localização no mapa e receber corridas próximas.",
        "NSLocationAlwaysUsageDescription": "Para receber corridas mesmo com o app em segundo plano."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.eightyeightmobility.driver",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F59E0B",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O 88 Mobility precisa de acesso às suas fotos para upload da CNH e CRLV.",
          "cameraPermission": "O 88 Mobility precisa de acesso à câmera para fotografar sua CNH e CRLV."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api",
      "eas": {
        "projectId": "cbdcbff1-089e-490c-a984-d7bfe91954b2"
      }
    },
    "owner": "asmag"
  }
}
